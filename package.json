{
  "name": "Circle",
  "version": "0.1.6",
  "description": "BTC Digital signage app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "bash test/run.sh",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [
    "electron",
    "digital-signage",
    "kiosk"
  ],
  "author": "Rom Kov",
  "license": "GPLv3",
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yourcompany.circle",
    "productName": "Circle",
    "directories": {
      "output": "dist"
    },
    "icon": "icons/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "facts.js",
      "wifi.js",
      "index.html",
      "style.css",
      "config.json",
      "bitcoin_facts.json",
      "*.svg",
      "icons/icon.png",
      "Quotes/index.html",
      "Quotes/script.js",
      "Quotes/style.css",
      "Quotes/*.ttf",
      "Quotes/minified/TweenMax.min.js",
      "Quotes/minified/SplitText.min.js"
    ],
    "mac": {
      "icon": "icons/icon.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.2",
    "lunarphase-js": "^2.0.3"
  }
}
